# Copy to .env for local development or .env.production for Docker Compose.
# Never commit either populated file. Values below are intentionally non-secret.

NODE_ENV=development
APP_FEATURE_PROFILE=full-campus
APP_VERSION=development
NUXT_PUBLIC_APP_NAME=Nusa Campus
NUXT_PUBLIC_APP_ENVIRONMENT=development
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_PUBLIC_DEMO_MODE=true
ENABLE_DEMO_AUTH=true

# Generate a unique value of at least 32 random bytes for production.
NUXT_SESSION_SECRET=
DEMO_SESSION_SECRET=

# Public HTTPS page Firebase returns to after completing a password-reset
# action. Keep this on the institution-owned application origin.
PASSWORD_RESET_CONTINUE_URL=

# Transactional email is sent through an institution-managed HTTPS gateway.
# The worker endpoint is called by the scheduler with EMAIL_WORKER_SECRET.
EMAIL_DELIVERY_ENDPOINT=
EMAIL_DELIVERY_BEARER_TOKEN=
EMAIL_FROM=
EMAIL_WORKER_SECRET=

# Server-side Firebase Admin. Production Compose uses Application Default
# Credentials from the read-only file named by FIREBASE_ADMIN_CREDENTIALS_FILE.
FIREBASE_PROJECT_ID=
GCLOUD_PROJECT=
FIREBASE_USE_APPLICATION_DEFAULT=false
FIREBASE_ADMIN_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=

# Alternative server credential inputs (do not use these in committed files).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local emulator only, for example 127.0.0.1:8080. Leave blank in production.
FIRESTORE_EMULATOR_HOST=
CAMPUS_DATA_MODE=mock
ALLOW_PRODUCTION_MOCK=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY_SECRET=

# HMAC key used to deduplicate PMB identities without storing the raw identity
# number. Use an independent value with at least 32 random bytes.
PMB_PII_HASH_SECRET=

# Institution-owned HTTPS origin used to create one-time tracer-study links.
# Do not include credentials, query parameters, or fragments.
TRACER_STUDY_PUBLIC_URL=

# Private file service. Uploaded objects remain quarantined until the ClamAV
# stream scan succeeds. Use at least 32 random bytes for FILE_CURSOR_SECRET.
FILE_QUOTA_BYTES=262144000
FILE_CURSOR_SECRET=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Development/test can enable the same two-person import approval used
# unconditionally in production.
IMPORT_REQUIRE_DUAL_APPROVAL=false

# Firebase browser configuration is public by design, but Firebase Security
# Rules and App Check—not obscurity—must enforce access.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Legacy direct Neo Feeder credentials are optional and retained only for a
# separately reviewed migration adapter. The version-pinned campus gateway
# below is the supported production integration.
NEO_FEEDER_BASE_URL=
NEO_FEEDER_USERNAME=
NEO_FEEDER_PASSWORD=
NEO_FEEDER_TIMEOUT_MS=30000
NEO_FEEDER_MAX_ATTEMPTS=5

# Version-pinned campus gateway contract for PDDIKTI. Operation keys are
# opaque values supplied only after the institution verifies its deployed
# gateway/vendor contract; this application does not assume Neo Feeder action names.
PDDIKTI_CONTRACT_VERSION=campus-pddikti-gateway/2026-01
PDDIKTI_OPERATION_MAP_JSON={}
PDDIKTI_ADAPTER_BASE_URL=
PDDIKTI_ADAPTER_BEARER_TOKEN=
PDDIKTI_ADAPTER_TIMEOUT_MS=20000
PDDIKTI_MAX_BATCH_SIZE=50
# Independent scheduler-to-worker secret containing at least 32 random bytes.
PDDIKTI_WORKER_SECRET=

# Server-only payment gateway webhook contract. Use a random secret of at
# least 32 bytes and configure the same HMAC-SHA256 contract at the provider.
PAYMENT_GATEWAY_PROVIDER_ID=campus-bank
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Error telemetry is disabled when DSNs are blank. Client telemetry must use a
# separate, restricted DSN and the documented beforeSend scrubber.
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=

# Analytics is opt-in. Keep private-area tracking false in every environment.
NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_ANALYTICS_PRIVATE_ENABLED=false
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NUXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NUXT_PUBLIC_MICROSOFT_CLARITY_ID=
NUXT_PUBLIC_GOOGLE_FONTS_ENABLED=false

# Docker Compose substitution values (host paths, not container paths).
APP_IMAGE=campus-platform:local
SERVER_NAME=campus.example.ac.id
TLS_FULLCHAIN_FILE=
TLS_PRIVATE_KEY_FILE=
