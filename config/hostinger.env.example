# Import this template into hPanel only after replacing every required blank.
# Never commit a populated copy or paste values into build logs or tickets.

NODE_ENV=production
DEPLOYMENT_TARGET=hostinger
TRUSTED_PROXY_HOPS=1
APP_FEATURE_PROFILE=lms-mvp
APP_VERSION=
NUXT_PUBLIC_APP_NAME=Nusa Campus
NUXT_PUBLIC_APP_ENVIRONMENT=production
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_PUBLIC_DEMO_MODE=false
ENABLE_DEMO_AUTH=false
NITRO_HOST=0.0.0.0
# Hostinger injects PORT. Do not add NITRO_PORT or override PORT.

NUXT_SESSION_SECRET=
DEMO_SESSION_SECRET=
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_BACKEND=firestore

EMAIL_DELIVERY_ENABLED=false
PASSWORD_RESET_CONTINUE_URL=
EMAIL_DELIVERY_ENDPOINT=
EMAIL_DELIVERY_BEARER_TOKEN=
EMAIL_FROM=
EMAIL_WORKER_SECRET=

FIREBASE_PROJECT_ID=
GCLOUD_PROJECT=
FIREBASE_USE_APPLICATION_DEFAULT=false
FIREBASE_ADMIN_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIRESTORE_EMULATOR_HOST=
CAMPUS_DATA_MODE=firebase
ALLOW_PRODUCTION_MOCK=false

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

FILE_UPLOADS_ENABLED=false
FILE_QUOTA_BYTES=262144000
FILE_CURSOR_SECRET=
CLAMAV_HOST=
CLAMAV_PORT=3310
IMPORT_REQUIRE_DUAL_APPROVAL=true

SENTRY_ENABLED=false
SENTRY_DSN=
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_RELEASE=

NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_ANALYTICS_PRIVATE_ENABLED=false
NUXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NUXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NUXT_PUBLIC_MICROSOFT_CLARITY_ID=
