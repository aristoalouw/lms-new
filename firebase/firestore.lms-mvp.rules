rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn()
        && 'roles' in request.auth.token
        && request.auth.token.roles is list
        && 'administrator' in request.auth.token.roles;
    }

    function isValidDirectProfile(data) {
      return data.keys().hasAll(['displayName', 'phone', 'photoURL', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 150
        && data.phone is string
        && data.phone.size() <= 32
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && (data.photoURL == ''
          || data.photoURL.matches('^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?(/[A-Za-z0-9._~:/?#@!$&()*+,;=%-]*)?$'))
        && data.updatedAt is string
        && data.updatedAt.size() == 24
        && data.updatedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
    }

    function isOwnerProfileUpdate(userId) {
      return signedIn()
        && !isAdministrator()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'photoURL', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['updatedAt'])
        && isValidDirectProfile(request.resource.data);
    }

    // Hanya profil minimum milik pengguna yang boleh dibaca/diubah langsung.
    // Akun, kelas, LMS, file, audit, dan seluruh modul lain wajib melalui Nitro API.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, delete: if false;
      allow update: if isOwnerProfileUpdate(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
