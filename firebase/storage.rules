rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && request.auth.token.roles is list
        && role in request.auth.token.roles;
    }

    function isAdmin() {
      return hasRole('administrator');
    }

    function safeDocument() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    function safeProfileImage() {
      return request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
    }

    match /profile-images/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && safeProfileImage();
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /student-documents/{studentId}/{fileName} {
      allow read: if signedIn()
        && (resource.metadata.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.auth.token.scope is map
        && request.auth.token.scope.studentIds is list
        && studentId in request.auth.token.scope.studentIds
        && safeDocument();
      allow update: if false;
      allow delete: if signedIn()
        && (resource.metadata.ownerUid == request.auth.uid || isAdmin());
    }

    match /admissions/public/{fileName} {
      allow read: if true;
      allow create, update: if (hasRole('admissions_staff') || isAdmin()) && safeDocument();
      allow delete: if hasRole('admissions_staff') || isAdmin();
    }

    // Server-only objects are delivered through short-lived signed URLs.
    match /private/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
