{
  "name": "nusa-campus",
  "version": "0.1.0",
  "private": true,
  "description": "Platform sistem informasi kampus terpadu berbasis Nuxt, Vue, Bootstrap, dan Firebase.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "lint": "eslint .",
    "check:no-ai": "node scripts/no-ai-scan.mjs",
    "check:dependencies": "node scripts/dependency-audit.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:api": "vitest run tests/server tests/security",
    "test:rules": "firebase emulators:exec --config firebase/firebase.json --project demo-lms-mvp --only firestore,storage \"vitest run tests/integration/firebase --no-file-parallelism\"",
    "firebase:prepare:spark": "node scripts/prepare-firebase-spark.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full-campus": "playwright test --config playwright.full-campus.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package:hostinger": "node scripts/package-hostinger-release.mjs",
    "verify:hostinger": "node scripts/verify-hostinger-release.mjs",
    "audit:firebase-identities": "node scripts/audit-firebase-identities.mjs",
    "audit:campus-readiness": "node scripts/audit-campus-readiness.mjs",
    "seed:lms-mvp": "node scripts/seed-lms-mvp.mjs",
    "bootstrap:lms-admin": "node scripts/bootstrap-lms-admin.mjs"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@sentry/node": "10.67.0",
    "@sentry/vue": "10.67.0",
    "axios": "1.21.1",
    "bootstrap": "5.3.8",
    "choices.js": "11.2.3",
    "firebase": "12.16.0",
    "firebase-admin": "14.5.1",
    "jquery": "3.7.1",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "nuxt": "3.21.11",
    "qrcode": "1.5.4",
    "quill": "2.0.2",
    "select2": "4.1.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@nuxt/webpack-builder": "3.21.11",
    "@playwright/test": "1.61.1",
    "@types/jquery": "4.0.1",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "firebase-tools": "15.24.0",
    "globals": "16.4.0",
    "happy-dom": "21.0.4",
    "sass": "1.101.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "@grpc/grpc-js@<=1.13.5": "1.14.7",
    "basic-ftp@<=6.2.3": "6.2.6",
    "brace-expansion@<=1.1.20": "1.1.21",
    "brace-expansion@2.0.0 - 2.1.7": "2.1.8",
    "brace-expansion@4.0.0 - 5.0.12": "5.0.13",
    "fast-uri@3.0.0 - 3.1.8": "3.1.9",
    "hono@<=4.12.33": "4.13.1",
    "ip-address@<=10.3.0": "10.5.0",
    "js-yaml@4.0.0 - 4.3.1": "4.3.2",
    "undici@<=6.29.0": "6.29.1",
    "undici@>=8.0.0 <=8.12.3": "8.12.4"
  }
}
