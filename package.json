{
  "name": "nusa-campus",
  "version": "0.1.0",
  "private": true,
  "description": "Platform sistem informasi kampus terpadu berbasis Nuxt, Vue, Bootstrap, dan Firebase.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs build",
    "start": "node .output/server/index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "lint": "eslint .",
    "check:no-ai": "node scripts/no-ai-scan.mjs",
    "check:dependencies": "node scripts/dependency-audit.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:api": "vitest run tests/server tests/security",
    "test:rules": "firebase emulators:exec --config firebase/firebase.json --project demo-lms-mvp --only firestore,storage \"vitest run tests/integration/firebase\"",
    "firebase:prepare:spark": "node scripts/prepare-firebase-spark.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:lms-mvp": "node scripts/seed-lms-mvp.mjs",
    "bootstrap:lms-admin": "node scripts/bootstrap-lms-admin.mjs"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@sentry/node": "10.67.0",
    "@sentry/vue": "10.67.0",
    "axios": "1.18.1",
    "bootstrap": "5.3.8",
    "choices.js": "11.2.3",
    "core-js": "3.49.0",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "jquery": "3.7.1",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "nuxt": "3.21.9",
    "qrcode": "1.5.4",
    "quill": "2.0.2",
    "select2": "4.1.0",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@nuxt/webpack-builder": "3.21.9",
    "@playwright/test": "1.61.1",
    "@types/jquery": "4.0.1",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "firebase-tools": "15.24.0",
    "globals": "16.4.0",
    "happy-dom": "20.11.0",
    "sass": "1.101.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
